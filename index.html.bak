<!-- MODAL -->
<div class="modal-overlay" id="modal">
  <div class="modal">
    <span class="modal-close" onclick="closeModal()">×</span>
    <div class="modal-title" id="modal-title"></div>
    <div class="modal-imgs" id="modal-imgs"></div>
  </div>
</div>

<script>
// ===== NAVIGATION =====
const sections = document.querySelectorAll('.section');
const navLinks = document.querySelectorAll('#main-nav a');

function showSection(id) {
  sections.forEach(s => s.classList.remove('active'));
  navLinks.forEach(a => a.classList.remove('active'));
  const sec = document.getElementById(id);
  if (sec) sec.classList.add('active');
  const link = document.querySelector(`#main-nav a[data-sec="${id}"]`);
  if (link) link.classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

navLinks.forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    showSection(a.dataset.sec);
  });
});

// hash support
if (location.hash) {
  const id = location.hash.slice(1);
  if (document.getElementById(id)) showSection(id);
}

// ===== POSITIONS =====
const territoryNames = [
  "5 — Дрифт","7 — ГШ","12 — Аренда","20 — Аренда","1 — АЗС","Ангар УЗИ",
  "Аренда лодок","Динозаврик","Зелёный мост","Красный мост","Мост ВЗМ","Мост Мара",
  "Рыбка","Сиськи","ТАТУ-2","ТВ","Тропа ФИБ","Тшка","Церковь-1","Чумаш",
  "1 — Амфик","2 — Амфик","3 — Церковь","3 — Репаир","9 — ГШ","Буквы","Сэндик","Теплицы","Особы","Каблук","Треугольники"
];

document.getElementById('territory-points').innerHTML = territoryNames.map(n =>
  `<div class="point-item">${n}</div>`
).join('');

let positionsData = [];

async function loadPositions() {
  try {
    const res = await fetch('positions.json');
    positionsData = await res.json();
  } catch(e) {
    console.error(e);
    positionsData = [];
  }
  renderPositions(positionsData);
}

function renderPositions(list) {
  const grid = document.getElementById('pos-grid');
  grid.innerHTML = list.map(p => {
    const mapSrc = p.map ? `positions/${p.map}` : '';
    const airSrc = p.air ? `positions/${p.air}` : (p.extra && p.extra[0] ? `positions/${p.id}/${p.extra[0]}` : '');
    return `<div class="pos-card" data-id="${p.id}" onclick="openPos('${p.id}')">
      <div class="imgs">
        ${mapSrc ? `<img src="${mapSrc}" alt="карта" loading="lazy">` : '<div style="background:#111"></div>'}
        ${airSrc ? `<img src="${airSrc}" alt="воздух" loading="lazy">` : '<div style="background:#111"></div>'}
      </div>
      <div class="name">${p.name}</div>
    </div>`;
  }).join('');
}

function openPos(id) {
  const p = positionsData.find(x => x.id === id);
  if (!p) return;
  document.getElementById('modal-title').textContent = p.name;
  let html = '';
  if (p.map) html += `<img src="positions/${p.map}" alt="Карта">`;
  if (p.air) html += `<img src="positions/${p.air}" alt="С вертолёта">`;
  if (p.extra) {
    p.extra.forEach(f => html += `<img src="positions/${p.id}/${f}" alt="">`);
  }
  document.getElementById('modal-imgs').innerHTML = html;
  document.getElementById('modal').classList.add('open');
}

function closeModal() {
  document.getElementById('modal').classList.remove('open');
}
document.getElementById('modal').addEventListener('click', e => {
  if (e.target.id === 'modal') closeModal();
});

// ===== ACCORDION =====
function toggleAcc(el) {
  el.parentElement.classList.toggle('open');
}

// ===== SEARCH =====
const searchIndex = [];
function buildSearchIndex() {
  // positions
  positionsData.forEach(p => {
    searchIndex.push({ type: 'Позиция', title: p.name, sec: 'positions', id: p.id });
  });
  // ranks keywords
  ['поставка','патруль','тренировка','баллы','ранг','повышение','инструктор'].forEach(k =>
    searchIndex.push({ type: 'Ранги', title: k, sec: 'ranks' })
  );
  // territory
  territoryNames.forEach(n => searchIndex.push({ type: 'Территория', title: n, sec: 'territory' }));
  // fight
  ['пик','хевик','тепловизор','броник','поставка','оружие'].forEach(k =>
    searchIndex.push({ type: 'Файт', title: k, sec: 'fight' })
  );
  // uk
  ['статья 1','принцип законности','вина','рецидив','соучастие','приготовление','покушение'].forEach(k =>
    searchIndex.push({ type: 'УК', title: k, sec: 'uk' })
  );
  // ustav
  ['выговор','увольнение','субординация','снаряжение','лицензия'].forEach(k =>
    searchIndex.push({ type: 'Устав', title: k, sec: 'ustav' })
  );
  // hierarchy
  ['commander','deputy','instructor','обязанности'].forEach(k =>
    searchIndex.push({ type: 'Иерархия', title: k, sec: 'hierarchy' })
  );
  // flight
  ['лётный экзамен','лицензия','маршрут','13 минут'].forEach(k =>
    searchIndex.push({ type: 'Лётный', title: k, sec: 'flight-exam' })
  );
}

const searchInput = document.getElementById('global-search');
const searchResults = document.getElementById('search-results');

searchInput.addEventListener('input', () => {
  const q = searchInput.value.trim().toLowerCase();
  if (q.length < 1) { searchResults.style.display = 'none'; return; }
  const hits = searchIndex.filter(i => i.title.toLowerCase().includes(q)).slice(0, 12);
  if (!hits.length) {
    searchResults.innerHTML = '<div class="sr-item" style="color:var(--muted)">Ничего не найдено</div>';
  } else {
    searchResults.innerHTML = hits.map(h =>
      `<div class="sr-item" data-sec="${h.sec}" data-id="${h.id||''}">
        <span class="sr-tag">${h.type}</span>
        <span>${h.title}</span>
      </div>`
    ).join('');
  }
  searchResults.style.display = 'block';
});

searchResults.addEventListener('click', e => {
  const item = e.target.closest('.sr-item');
  if (!item) return;
  const sec = item.dataset.sec;
  showSection(sec);
  if (item.dataset.id && sec === 'positions') {
    setTimeout(() => openPos(item.dataset.id), 100);
  }
  searchResults.style.display = 'none';
  searchInput.value = '';
});

document.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) searchResults.style.display = 'none';
});

// INIT
loadPositions().then(() => {
  buildSearchIndex();
});
</script>
</body>
</html>
